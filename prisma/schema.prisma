generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------
// Roles & Permissions
// ------------------------
enum Role {
  STUDENT        // signed up via a recognized college email domain
  LEARNER        // regular public user, no college affiliation
  INSTRUCTOR     // can create/edit content for their college
  COLLEGE_ADMIN  // manages users + content within their college
  SUPER_ADMIN    // full platform access
}

// A partner college. Matching a user's email domain to a College
// row is how we auto-detect "this is a student from X college".
model College {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique   // e.g. "vjti.ac.in"
  isVerified  Boolean  @default(true) // false if pending manual approval
  createdAt   DateTime @default(now())
  users       User[]
}

// ------------------------
// NextAuth required models
// ------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------
// User
// ------------------------
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?   // null if user only ever used Google OAuth
  role           Role      @default(LEARNER)

  collegeId      String?
  college        College?  @relation(fields: [collegeId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
}
enum NodeType {
  SUBJECT
  CHAPTER
  ALGORITHM
}

model Node {
  id         String   @id @default(cuid())
  parentId   String?
  parent     Node?    @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   Node[]   @relation("NodeChildren")
  type       NodeType
  slug       String   @unique
  title      String
  orderIndex Int      @default(0)
  lesson     Lesson?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lesson {
  id                        String   @id @default(cuid())
  nodeId                    String   @unique
  node                      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  entryFunctionName         String
  defaultCode               String   @db.Text
  visualTheme               String   @default("warehouse")
  explanationStart          String   @db.Text
  explanationCompareGreater String   @db.Text
  explanationCompareLess    String   @db.Text
  explanationSwap           String   @db.Text
  explanationMarkSorted     String   @db.Text
  explanationDone           String   @db.Text
  updatedAt                 DateTime @updatedAt
}